---
interface Props {
  name: string
  label: string
  options: readonly string[]
  multiple?: boolean
}
const {name, label, options, multiple} = Astro.props
---
<fieldset>
  <legend>{label}</legend>
  <div class="choices">
    {options.map(option => <label class="chip"><input type={multiple ? 'checkbox' : 'radio'} name={name} value={option} /><span>{option}</span></label>)}
  </div>
</fieldset>
