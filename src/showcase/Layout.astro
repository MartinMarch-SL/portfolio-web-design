---
import PortfolioIcons from '../lib/PortfolioIcons.astro'
import '@fontsource-variable/inter-tight'
import './tokens.css'
const { title = 'Catálogo de proyectos · 2026' } = Astro.props
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <PortfolioIcons />
    <title>{title}</title>
  </head>
  <body><slot /></body>
</html>
