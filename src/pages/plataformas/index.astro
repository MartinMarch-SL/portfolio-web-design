---
import Layout from '../../showcase/Layout.astro'
import { plataformas } from '../../showcase/encargo/data/plataformas'
import { url } from '../../lib/url'
import '@fontsource-variable/archivo/wdth.css'
import '@fontsource/jetbrains-mono/400.css'
---
<Layout title="Plataformas · Catálogo de proyectos">
  <header class="platform-header">
    <a href={url('')}>Catálogo de proyectos</a>
    <a href={url('encargo/')}>Encargo</a>
  </header>
  <main class="platforms">
    <h1>Plataformas</h1>
    <p class="intro">De una web que presenta tu negocio a un producto que conecta a tus usuarios. Cada tipo suma una capa.</p>
    <ol class="layers" aria-label="Capas de una plataforma">
      {plataformas.map(({ tipo, capa }) => <li><span>0{tipo}</span>{capa}</li>)}
    </ol>
    <section aria-label="Comparativa de plataformas" class="comparison">
      {plataformas.map(({ tipo, nombre, descripcion, incluye, noIncluye, plazo, datos, ejemplos }) => (
        <article>
          <p class="number">Tipo 0{tipo}</p>
          <h2>{nombre}</h2>
          <p>{descripcion}</p>
          <dl>
            <dt>Incluye</dt><dd>{incluye}</dd>
            <dt>No incluye</dt><dd>{noIncluye}</dd>
            <dt>Plazo orientativo</dt><dd>{plazo}</dd>
            <dt>Qué te preguntaremos</dt><dd>{datos}</dd>
            <dt>Ejemplos</dt><dd>{ejemplos.length ? <ul>{ejemplos.map(([name, path]) => <li><a href={url(path)}>{name}</a></li>)}</ul> : 'Proyectos a medida'}</dd>
          </dl>
        </article>
      ))}
    </section>
    <a class="start" href={url('encargo/')}>Empezar mi encargo</a>
  </main>
</Layout>
<style>
  .platform-header, .platforms { margin-inline: auto; width: min(91%, 100rem); }
  .platform-header { display: flex; justify-content: space-between; padding-block: 1.15rem; border-bottom: 1px solid var(--rule); font: .75rem var(--mono); }
  .platforms { padding-block: clamp(2rem, 6vw, 6rem); }
  .platforms h1 { margin: 0; font: 900 clamp(2.9rem, 10vw, 9.5rem)/.94 'Archivo Variable', sans-serif; letter-spacing: -.065em; }
  .intro { max-width: 40ch; font-size: clamp(1.25rem, 2vw, 2rem); }
  .layers { display: grid; gap: .55rem; padding: 0; margin: 2rem 0 3rem; list-style: none; }
  .layers li { padding: .8rem; border: 1px solid var(--rule); box-shadow: 0 4px #080808; background: #222; font-weight: 750; }
  .layers li:nth-child(2) { margin-left: 5%; }
  .layers li:nth-child(3) { margin-left: 10%; }
  .layers li:nth-child(4) { margin-left: 15%; }
  .layers span, .number, dt { color: var(--muted); font: .75rem var(--mono); }
  .layers span { margin-right: .8rem; }
  .comparison { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1px; background: var(--rule); border: 1px solid var(--rule); }
  article { padding: clamp(1rem, 2vw, 2rem); background: var(--paper); }
  h2 { font: 850 clamp(1.3rem, 2.25vw, 2.5rem)/1 'Archivo Variable', sans-serif; letter-spacing: -.045em; overflow-wrap: anywhere; }
  dd { margin: .4rem 0 1rem; }
  dd ul { padding-left: 1rem; }
  .start { display: inline-block; margin-top: 2rem; background: var(--ink); color: var(--paper); padding: .85rem 1rem; font-weight: 750; }
  @media (max-width: 850px) { .comparison { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 480px) { .comparison { grid-template-columns: minmax(0, 1fr); } }
</style>
