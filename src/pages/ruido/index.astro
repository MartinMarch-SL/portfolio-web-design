---
import Layout from '../../examples/ruido/Layout.astro'
import Hero from '../../examples/ruido/components/Hero.astro'
import Ticker from '../../examples/ruido/components/Ticker.astro'
import Countdown from '../../examples/ruido/components/Countdown.astro'
import DropRail from '../../examples/ruido/components/DropRail.astro'
import Manifesto from '../../examples/ruido/components/Manifesto.astro'
import Lookbook from '../../examples/ruido/components/Lookbook.astro'
import Workshop from '../../examples/ruido/components/Workshop.astro'
import Newsletter from '../../examples/ruido/components/Newsletter.astro'
---
<Layout>
  <main class="ruido-home" id="inicio">
    <Hero />
    <Ticker />
    <Countdown />
    <DropRail />
    <Manifesto />
    <Lookbook />
    <Workshop />
    <Newsletter />
  </main>
</Layout>
<style is:global>
  .ruido-home .section-line { display: flex; flex-wrap: wrap; justify-content: space-between; gap: .25rem 1rem; border-top: 1px solid var(--hairline); padding-top: .65rem; font: clamp(.625rem, 1vw, .8rem)/1.5 var(--mono); text-transform: uppercase; }
  .ruido-home .section-line :is(h2, p) { margin: 0; font: inherit; }
  .ruido-home .section-line a:hover { text-decoration: underline; }
</style>
<script>
  import '../../examples/ruido/scripts/home'
  import '../../examples/ruido/scripts/countdown'
</script>
