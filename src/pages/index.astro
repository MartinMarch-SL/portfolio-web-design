---
import Layout from '../showcase/Layout.astro'
import { kinds, projects } from '../showcase/projects'
import { url } from '../lib/url'
import '@fontsource-variable/archivo/wdth.css'
import '@fontsource/jetbrains-mono/400.css'
---
<Layout>
  <div class="catalogue">
    <header class="catalogue-header">
      <a href={url('')}>Catálogo de proyectos</a>
      <nav aria-label="Menú del catálogo">
        <a href={url('#webs')}>Webs</a>
        <a href={url('encargo/')}>Encargo</a>
      </nav>
    </header>
    <main>
      <h1 class="display">Webs<br /> a medida.</h1>
      <section id="webs" aria-label="Webs por tipo" data-carousel>
        <div class="filters" role="group" aria-label="Tipo de web" hidden>
          {['Todas', ...kinds].map((kind, index) => (
            <button type="button" data-filter={index === 0 ? '' : kind} aria-pressed={index === 0 ? 'true' : 'false'}>
              {kind} <span>{index === 0 ? projects.length : projects.filter(project => project.kind === kind).length}</span>
            </button>
          ))}
        </div>
        <div class="stage" data-stage>
          <ol class="screens" data-screens aria-label="Proyectos">
            {projects.map(project => (
              <li data-project data-kind={project.kind} data-sector={project.sector}>
                <a class="screen" href={project.href} aria-label={project.name} draggable="false">
                  <img class="screen-desktop" src={project.desktop} alt="" width="1440" height="900" draggable="false" />
                  <img class="screen-mobile" src={project.mobile} alt="" width="375" height="812" draggable="false" />
                  <span class="screen-name">{project.name}</span>
                </a>
              </li>
            ))}
          </ol>
        </div>
        <div class="selection" data-selection hidden>
          <div aria-live="polite" aria-atomic="true">
            <h2 class="display" data-name>{projects[0].name}</h2>
            <p data-details>{projects[0].kind} · {projects[0].sector}</p>
          </div>
          <div class="actions">
            <a data-open href={projects[0].href}>Ver web</a>
            <div role="group" aria-label="Navegación de proyectos">
              <button type="button" data-direction="-1">Anterior</button>
              <button type="button" data-direction="1">Siguiente</button>
            </div>
          </div>
        </div>
      </section>
    </main>
    <footer class="catalogue-footer">
      <p>Encargo</p>
      <h2 class="display">Tu web empieza aquí.</h2>
      <a href={url('encargo/')}>Preparar un encargo</a>
    </footer>
  </div>
</Layout>
<script>
  import '../showcase/carousel'
</script>
