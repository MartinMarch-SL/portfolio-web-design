---
import { url } from '../../../lib/url'
import Layout from '../Layout.astro'
import { flash, flashSvg } from '../data/flash'
---
<Layout title="Flash" section="flash">
  <section class="wrap page">
    <p class="eyebrow">Diseños disponibles</p><h1>Flash</h1>
    <p class="intro">Piezas ya dibujadas, con una medida de partida. Podemos ajustar la escala y la colocación al probarlas sobre el cuerpo.</p>
    <div class="flash-grid">{flash.map(design => <article>
      <div class="flash-art" aria-hidden="true" set:html={flashSvg(design)}></div>
      <div class="flash-meta"><h2>{design.name}</h2><p class="mono">{design.style} · {design.size} cm<br />Desde {design.price} €</p>
      <a class="text-link" href={url(`lia-ferro/encargo/?flash=${design.id}`)}>Llevar al cuerpo</a></div>
    </article>)}</div>
  </section>
</Layout>
