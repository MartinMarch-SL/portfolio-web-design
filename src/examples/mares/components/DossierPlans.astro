---
import { plans } from '../data/plans'
import { propertyImage, type Property } from '../data/properties'
import Photo from './Photo.astro'
import Plan from './Plan.astro'
const { property } = Astro.props as { property: Property }
const plan = plans[property.slug]
---
<section class="section dossier" data-live-plan>
  <div class="section-head"><div><p class="kicker">01 / {plan.level}</p><h2>Planta</h2></div><p class="kicker">Esquema orientativo</p></div>
  <div class="dossier-grid">
    <div class="drawing">
      <Plan {plan} />
      <p class="drawing-caption" data-room-info aria-live="polite">Selecciona una estancia.</p>
    </div>
    <div class="room-photos">
      {['a','b','c'].map(key => <div data-room-image={key} data-active={key === 'a' ? '' : undefined} aria-hidden={key !== 'a'}>
        <Photo path={propertyImage(property, key)} alt={`Vista de ${property.name}`} />
      </div>)}
    </div>
  </div>
</section>
<section class="section dossier" data-solar>
  <div class="section-head"><div><p class="kicker">02 / Orientación</p><h2>El recorrido de la luz</h2></div><p class="kicker" data-solar-date></p></div>
  <div class="dossier-grid">
    <div class="drawing"><Plan {plan} solar /><p class="drawing-caption">Incidencia estimada en fachada y dirección de la sombra.</p></div>
    <div class="light-controls">
      <label for="solar-hour">Hora local <output for="solar-hour" data-hour>10:00</output></label>
      <svg class="solar-arc" viewBox="0 0 240 130" aria-hidden="true">
        <path d="M20 110a100 100 0 0 1 200 0M20 110h200" />
        <circle data-sun cx="20" cy="110" r="5" />
      </svg>
      <input id="solar-hour" type="range" min="7" max="21" step=".25" value="10" />
      <div class="hour-scale" aria-hidden="true"><span>07:00</span><span>14:00</span><span>21:00</span></div>
      <p class="note" data-solar-status></p>
    </div>
  </div>
</section>
