---
import { url } from '../../../lib/url'
import { areaName, propertyImage, propertyPath, propertyPrice, type Property } from '../data/properties'
import Photo from './Photo.astro'
const { property } = Astro.props as { property: Property }
---
<article class="property-card" data-property={property.slug}>
  <a href={url(propertyPath(property))}>
    <Photo path={propertyImage(property)} sizes="(max-width: 650px) 100vw, 50vw" />
    <div class="card-content">
      <p class="kicker">{areaName(property.area)} / {property.operation}</p>
      <h3>{property.name}</h3>
      <div class="card-data"><span>{property.size} m² / {property.rooms} dormitorios</span><span>{propertyPrice(property)}</span></div>
    </div>
  </a>
</article>
