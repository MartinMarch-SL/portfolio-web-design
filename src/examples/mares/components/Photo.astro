---
import { responsiveImage } from '../../../lib/responsive-image'
const { path, alt = '', width = 1600, height = 1067, sizes = '(max-width: 720px) 100vw, 60vw', eager = false, reveal = false } = Astro.props
---
<div class="photo" data-reveal={reveal || undefined}>
  <div class="photo-plane">
    <img {...responsiveImage(path, sizes, width)} {alt} {width} {height} loading={eager ? 'eager' : 'lazy'} decoding="async" />
  </div>
</div>
