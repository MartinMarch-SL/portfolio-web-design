---
import Layout from '../Layout.astro'
import { areas, features } from '../data/properties'
import { valuationExtras } from '../lib/finance'
import Contact from './Contact.astro'
import Photo from './Photo.astro'
---
<Layout title="Vender">
  <section class="section page-intro"><p class="kicker">Vende con Marès</p><h1>¿Cuánto vale tu casa?</h1><p>Estima el precio de venta de tu vivienda en tres pasos.</p></section>
  <section class="section split">
    <div class="valuation-panel">
      <form data-valuation>
        <p class="kicker" data-step-count aria-live="polite">Paso 1 de 3</p>
        <fieldset data-step>
          <legend>¿Dónde está?</legend>
          <label>Barrio<select name="barrio" required><option value="">Elige un barrio</option>{areas.map(area => <option value={area.id}>{area.name}</option>)}</select></label>
        </fieldset>
        <fieldset data-step hidden disabled>
          <legend>¿Qué superficie tiene?</legend>
          <label>Superficie construida (m²)<input name="superficie" type="number" min="15" max="3000" required /></label>
        </fieldset>
        <fieldset data-step hidden disabled>
          <legend>¿Cómo es la vivienda?</legend>
          <label>Estado<select name="estado"><option value="reformar">Para reformar</option><option value="bueno" selected>Buen estado</option><option value="reformado">Reformada</option></select></label>
          <div class="extras">{(Object.keys(valuationExtras) as (keyof typeof valuationExtras)[]).map(key => <label><input name="extra" type="checkbox" value={key} /> {features[key]}</label>)}</div>
        </fieldset>
        <div class="step-nav"><button type="button" class="text-button" data-back hidden>Atrás</button><button class="button" data-step-next>Continuar</button></div>
      </form>
      <div data-valuation-result hidden>
        <h2>Tu estimación</h2><output data-range aria-live="polite"></output>
        <p>Horquilla orientativa basada en el precio de referencia del barrio, la superficie, el estado y los extras.</p>
        <button type="button" class="text-button" data-edit>Editar los datos</button>
        <h3>Hablemos de tu vivienda</h3><Contact />
      </div>
    </div>
    <Photo path="examples/mares/img/prop-03-c.webp" width={1080} height={1350} reveal />
  </section>
</Layout>
