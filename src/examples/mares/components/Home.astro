---
import Layout from '../Layout.astro'
import { url } from '../../../lib/url'
import { areaName, properties, propertyImage, propertyPath, propertyPrice } from '../data/properties'
import Photo from './Photo.astro'
const featured = ['villa-de-la-cornisa', 'atico-del-molinar', 'finca-del-olivar', 'mirador-de-bendinat']
  .map(slug => properties.find(property => property.slug === slug)!)
const principles = [
  ['Medir antes de publicar', 'Estudiamos la planta, la orientación y las operaciones comparables para fijar el precio.'],
  ['Fotografiar la casa', 'Documentamos sus espacios a la hora en que mejor se entienden la luz y los materiales.'],
  ['Preparar cada visita', 'Contrastamos lo que busca cada comprador y coordinamos la negociación hasta la firma.'],
]
---
<Layout>
  <section class="hero" data-carousel aria-label="Viviendas destacadas">
    {featured.map((property, index) => <div class="hero-image" data-slide data-active={index === 0 ? '' : undefined} aria-hidden={index !== 0}>
      <Photo path={propertyImage(property)} alt={property.name} sizes="100vw" eager={index === 0} />
    </div>)}
    <div class="hero-heading">
      <p data-line>Marès / Mallorca</p>
      <h1 data-line>Casas en<br />cartera</h1>
    </div>
    <div class="hero-bottom">
      <div class="hero-controls">
        <div class="progress-track" aria-hidden="true"><div data-progress></div></div>
        <div class="hero-buttons">
          <button type="button" data-hero-prev>Anterior</button>
          <button type="button" data-hero-next>Siguiente</button>
          <button type="button" data-hero-pause>Pausar</button>
        </div>
      </div>
      <div class="title-block" aria-live="off" data-title-block>
        {featured.map((property, index) => <div data-caption hidden={index !== 0}>
          <dl>
            {[['Nº', String(properties.indexOf(property) + 1).padStart(2, '0'), true], ['Nombre', property.name, false], ['Zona', areaName(property.area), false], ['m²', property.size.toString(), true], ['Dormitorios', property.rooms.toString(), true], ['Precio', propertyPrice(property), true]].map(([label, value, roll]) =>
              <div><dt>{label}</dt><dd>{label === 'Nombre' ? <a href={url(propertyPath(property))}>{value}</a> : roll ? <span data-digits>{value}</span> : value}</dd></div>
            )}
          </dl>
        </div>)}
      </div>
    </div>
  </section>
  <section class="section property-index" data-index>
    <div class="section-head"><div><p class="kicker">01 / Cartera</p><h2>Índice</h2></div><a class="text-link" href={url('mares/propiedades/')}>Filtrar propiedades</a></div>
    <div class="index-labels index-grid" aria-hidden="true"><span>Nº</span><span>Vivienda</span><span>Zona</span><span>Superficie</span><span>Precio</span></div>
    {properties.map((property, index) => <a class="index-row index-grid" href={url(propertyPath(property))} data-index-row data-preview={url(propertyImage(property))}>
      <span class="index-no">{String(index + 1).padStart(2, '0')}</span>
      <div class="index-thumb"><Photo path={propertyImage(property)} sizes="100px" /></div>
      <span class="index-name">{property.name}</span><span class="index-zone">{areaName(property.area)}</span><span class="index-size">{property.size} m²</span><span class="index-price">{propertyPrice(property)}</span>
    </a>)}
    <div class="cursor-photo" aria-hidden="true"><img alt="" /></div>
  </section>
  <section class="section selling">
    <div><p class="kicker">02 / Método</p><h2>Cómo vendemos</h2></div>
    <ol>{principles.map(([title, copy], index) => <li><span class="kicker">0{index + 1}</span><div><h3>{title}</h3><p>{copy}</p></div></li>)}</ol>
  </section>
  <section class="section valuation-cta"><div><p class="kicker">03 / Valoración</p><h2>¿Cuánto vale tu casa?</h2></div><a class="text-link" href={url('mares/vender/')}>Estimar el precio</a></section>
</Layout>
