---
import Layout from '../Layout.astro'
import PageHero from './PageHero.astro'
import { categories, senior, contact } from '../data/season'
import { photo, route } from '../lib/paths'

const listings = [...categories, { id: 'senior', name: 'Sénior', first: 0, last: 0, teams: [senior] }]
---
<Layout title="Equipos" section="equipos">
  <PageHero><p class="eyebrow">16 EQUIPOS · TEMPORADA 2026/27</p><h1>Equipos</h1><p>Grupos, entrenamientos y cuotas de la cantera y del sénior amateur.</p></PageHero>
  <div class="acta">
    <nav class="wrap team-nav" aria-label="Categorías">{listings.map(category => <a href={'#' + category.id}>{category.name}</a>)}</nav>
    {listings.map(category => <section class="wrap section team-section" id={category.id}>
      <div>
        <p class="eyebrow">{category.first ? `Nacidos en ${category.first}–${category.last}` : 'Equipo adulto'}</p>
        <h2>{category.name}</h2>
        {category.first ? <a class="text-link" href={route('inscripcion/?anio=' + category.last)}>Preinscripción</a> : <a class="text-link" href={'mailto:' + contact}>Consultar plazas</a>}
      </div>
      <div>{category.teams.map(team => <div class="team">
        <h3>{team.name}</h3><p>{team.coach} · {team.field}</p><p class="eyebrow">{team.days} · {team.time} · {team.fee} € / año</p>
      </div>)}</div>
      {(['babybasket', 'premini'].includes(category.id) || category.teams.some(team => team.name.includes('femenino'))) && <img class="photo team-photo" {...photo(['babybasket', 'premini'].includes(category.id) ? 'babybasket' : 'femenino')} alt="" loading="lazy" />}
    </section>)}
  </div>
  <section class="parquet"><div class="wrap section split campus">
    <img class="photo" {...photo('entreno')} alt="" loading="lazy" />
    <div><h2>Cuotas y altas</h2><p>La cuota incluye licencia, seguro y equipación reversible. Matrícula de 35 € para nuevas altas y descuento del 10 % desde el segundo hermano. Pago en uno o tres plazos.</p><p>Si tu año de nacimiento queda fuera del rango, <a class="text-link" href={'mailto:' + contact}>escribe a secretaría</a>.</p></div>
  </div></section>
</Layout>
