---
import PageHero from './PageHero.astro'
import Layout from '../Layout.astro'
import { photo, route } from '../lib/paths'
import type { news } from '../data/season'
interface Props { item: typeof news[number] }
const { item } = Astro.props
---
<Layout title={item.title} section="noticias">
  <article>
    <PageHero><a class="text-link" href={route('noticias/')}>Todas las noticias</a><p class="eyebrow"><time datetime={item.date}>{item.label}</time> · {item.section}</p><h1>{item.title}</h1><p>{item.intro}</p></PageHero>
    <div class="acta article-body"><div class="wrap"><img class="photo article-image" {...photo(item.photo, '(max-width: 800px) 100vw, 800px')} alt="" /></div>
    <div class="wrap section prose">{item.body.map(paragraph => <p>{paragraph}</p>)}</div>
  </div>
  </article>
</Layout>
