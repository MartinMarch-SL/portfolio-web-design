---
import PortfolioIcons from '../../lib/PortfolioIcons.astro'
import { ClientRouter } from 'astro:transitions'
import { route, image } from './lib/paths'
import { contact } from './data/season'
import { url } from '../../lib/url'
import '@fontsource/saira-extra-condensed/latin-800.css'
import '@fontsource/saira-extra-condensed/latin-700.css'
import '@fontsource-variable/inter-tight'
import '@fontsource/jetbrains-mono/latin-400.css'
import './styles/site.css'
import './styles/court.css'
const { title, section = '' } = Astro.props
const links = [['', 'Inicio'], ['equipos', 'Equipos'], ['noticias', 'Noticias'], ['competicion', 'Competición'], ['club', 'El club'], ['inscripcion', 'Preinscripción']]
---
<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex, nofollow" />
  <meta name="theme-color" content="#0B1420" />
  <meta name="description" content="CB Pinar Alto, club de baloncesto del barrio desde 1984. Equipos, partidos y preinscripción para la temporada 2026/27." />
  <title>{title ? title + ' · CB Pinar Alto' : 'CB Pinar Alto · Baloncesto de barrio desde 1984'}</title>
  <PortfolioIcons name="pinar-alto" />
  <ClientRouter />
</head>
<body class:list={['pinar', 'pabellon', { 'has-court': !section }]} style={`--maple: url('${image('parquet-claro.webp')}'); --parquet-luz: url('${image('parquet-luz.webp')}'); --pabellon-noche: url('${image('pabellon-noche.webp')}'); --tablero: url('${image('tablero.webp')}'); --paper: url('${image('acta.webp')}');`}>
  <a class="skip" href="#contenido">Saltar al contenido</a>
  <header class="mast">
    <div class="wrap mast-inner">
      <a class="brand" href={route()}><img src={image('escudo.svg')} alt="" width="45" height="52" /><span>CB PINAR ALTO<small>BALONCESTO · DESDE 1984</small></span></a>
      <nav class="desktop-nav" aria-label="Principal">
        {links.map(([path, label]) => <a aria-current={section === path ? 'page' : undefined} href={route(path && path + '/')}>{label}</a>)}
      </nav>
      <div class="mobile-nav">
        <a class="primary mobile-signup" href={route('inscripcion/')} aria-current={section === 'inscripcion' ? 'page' : undefined}>Preinscripción</a>
        <button type="button" data-menu-open aria-haspopup="dialog" aria-controls="club-menu">Menú</button>
      </div>
    </div>
  </header>
  <dialog class="menu-overlay" id="club-menu" aria-label="Menú principal">
    <div class="wrap menu-inner">
      <button type="button" data-menu-close autofocus>Cerrar menú</button>
      <nav aria-label="Principal">
        {links.map(([path, label]) => <a aria-current={section === path ? 'page' : undefined} href={route(path && path + '/')}>{label}</a>)}
      </nav>
    </div>
  </dialog>
  <main id="contenido" tabindex="-1"><slot /></main>
  <footer class="footer pabellon">
    <div class="wrap footer-inner">
      <div>
        <a class="brand" href={route()}><img src={image('escudo.svg')} alt="" width="45" height="52" loading="lazy" /><span>CB PINAR ALTO<small>BALONCESTO · DESDE 1984</small></span></a>
        <p>Club ficticio · Temporada 2026/27</p>
      </div>
      <nav aria-label="El club">{links.slice(1).map(([path, label]) => <a href={route(path + '/')}>{label}</a>)}</nav>
      <div><p>Pabellón Municipal Pinar Alto</p><a href={'mailto:' + contact}>{contact}</a><br /><a href={url('')}>Volver al catálogo</a></div>
    </div>
    <div class="footer-wordmark" aria-hidden="true">CB PINAR ALTO</div>
  </footer>
  <script>import './scripts/main'</script>
</body>
</html>
