---
import type { CollectionEntry } from 'astro:content'
import { url } from '../../../lib/url'
import { readingTime } from '../lib/blog'
import Photo from './Photo.astro'
interface Props {
  post: CollectionEntry<'inesPosts'>
}
const { post } = Astro.props
---
<article class="essay-row" data-category={post.data.category}>
  <div>
    <h2><a href={url(`ines-arranz/blog/${post.id}/`)}>{post.data.title}</a></h2>
    <p class="eyebrow">{post.data.category} · {readingTime(post.body ?? '')} min</p>
  </div>
  <div class="essay-cover"><Photo name={post.data.cover} width={1600} height={1000} sizes="(max-width: 720px) 100px, 220px" /></div>
</article>
