---
import type { CollectionEntry } from 'astro:content'
import { url } from '../../../lib/url'
import { readingTime } from '../lib/blog'
import Photo from './Photo.astro'
interface Props {
  post: CollectionEntry<'inesPosts'>
  featured?: boolean
}
const { post, featured = false } = Astro.props
---
<article class:list={['post-card', { featured }]} data-category={post.data.category}>
  <Photo name={post.data.cover} width={1600} height={1000} sizes={featured ? '(max-width: 720px) 100vw, 58vw' : '(max-width: 720px) 100vw, 33vw'} eager={featured} />
  <div>
    <p class="eyebrow">{post.data.category} · {readingTime(post.body ?? '')} min</p>
    <h2><a href={url(`ines-arranz/blog/${post.id}/`)}>{post.data.title}</a></h2>
    <p>{post.data.excerpt}</p>
  </div>
</article>
