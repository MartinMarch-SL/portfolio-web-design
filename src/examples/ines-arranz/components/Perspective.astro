---
import { url } from '../../../lib/url'

const thoughts = [
  ['No soy suficiente', 'Estoy aprendiendo'],
  ['Siempre lo estropeo', 'A veces me equivoco, como todos'],
  ['Nadie me entiende', 'Todavía no he encontrado cómo decirlo'],
]
---
<section class="perspective" data-perspective aria-labelledby="perspective-title">
  <div class="perspective-sticky shell">
    <header class="perspective-copy">
      <p class="eyebrow">Psicología en Valencia y online</p>
      <h1 id="perspective-title">Cambiar de <em>perspectiva</em></h1>
      <a class="text-link" href={url('ines-arranz/agenda/?modalidad=llamada')}>Pedir una primera cita</a>
      <p class="appointment-note">Primera llamada de 15 min, sin coste</p>
    </header>
    <div class="perspective-study">
      <div class="perspective-stage" data-perspective-stage aria-hidden="true"></div>
      <div class="thoughts">
        <p class="eyebrow">Una forma de mirar lo que piensas</p>
        <ol aria-label="Ejemplos de reestructuración cognitiva">
          {thoughts.map(([thought, reframe]) => (
            <li class="pair"><p><del>{thought}</del></p><p>{reframe}</p></li>
          ))}
        </ol>
      </div>
      <p class="perspective-caption eyebrow" aria-hidden="true">
        <span>Desplázate para cambiar el punto de vista</span>
        <span data-perspective-count>1 / {thoughts.length}</span>
      </p>
    </div>
  </div>
</section>
<script>
  import '../scripts/perspective'
</script>
