---
import { url } from '../../../lib/url'
import { getPosts } from '../data/posts'
import { categories } from '../lib/blog'
import PostCard from './PostCard.astro'
const posts = await getPosts()
---
<div class="shell">
  <header class="intro section-heading">
    <div><p class="eyebrow">Notas de consulta</p><h1>Cuaderno</h1>
    <p>Ideas y preguntas para entender un poco mejor lo que sentimos.</p></div>
    <a href={url('ines-arranz/rss.xml')}>Suscribirse por RSS</a>
  </header>
  <div class="filters" aria-label="Filtrar por categoría" role="group" hidden>
    {['', ...categories].map(category => <button class="button secondary" type="button" data-filter={category} aria-pressed={String(!category)}>{category || 'Todas'}</button>)}
  </div>
  <p data-filter-status role="status" hidden></p>
  <div class="essay-index" data-post-list>
    {posts.map((post, index) => <PostCard {post} number={index + 1} />)}
  </div>
</div>
<script>
  import { matchesCategory } from '../lib/blog'
  const filters = document.querySelector<HTMLElement>('.filters')!
  const buttons = Array.from(filters.querySelectorAll<HTMLButtonElement>('[data-filter]'))
  const posts = document.querySelectorAll<HTMLElement>('[data-post-list] [data-category]')
  const status = document.querySelector<HTMLElement>('[data-filter-status]')!
  for (const button of buttons) {
    button.addEventListener('click', () => {
      buttons.forEach(item => item.setAttribute('aria-pressed', String(item === button)))
      let count = 0
      for (const post of posts) {
        post.hidden = !matchesCategory(post.dataset.category!, button.dataset.filter!)
        if (!post.hidden) count++
      }
      status.hidden = false
      status.textContent = count === 1 ? '1 entrada' : count + ' entradas'
    })
  }
  filters.hidden = false
</script>
