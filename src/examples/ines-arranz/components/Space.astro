---
import Photo from './Photo.astro'
---
<section class="shell section" aria-labelledby="espacio">
  <header class="section-heading">
    <div><p class="eyebrow">Ruzafa, Valencia</p><h2 id="espacio">La consulta</h2></div>
    <p>Un lugar tranquilo para hablar, en el barrio de Ruzafa. También podemos encontrarnos online.</p>
  </header>
  <div class="photo-composition">
    <figure><div data-parallax><Photo name="consulta-01" width={1600} height={1067} alt="Interior de la consulta" /></div></figure>
    <figure><div data-parallax><Photo name="retrato-02" /></div></figure>
    <figure><div data-parallax><Photo name="retrato-03" /></div></figure>
    <figure><div data-parallax><Photo name="consulta-02" alt="Un rincón de la consulta" /></div></figure>
  </div>
</section>
