---
import { url } from '../../../lib/url'
import { getPosts } from '../data/posts'
import Photo from './Photo.astro'
import Space from './Space.astro'
import PostCard from './PostCard.astro'
const posts = (await getPosts()).slice(0, 3)
const thoughts = [
  ['Seguro que es culpa mía', 'Puedo revisar qué parte depende de mí'],
  ['Debería poder con todo', 'Puedo pedir ayuda antes de agotarme'],
  ['Si digo que no, voy a decepcionar', 'Puedo cuidar el vínculo y poner un límite'],
]
const moments = [
  [0, 'Acogida', 'Nos damos unos minutos para llegar. Te cuento cómo funciona la consulta y puedes preguntarme lo que necesites.'],
  [8, 'Qué te trae', 'Hablamos de lo que te ha hecho pedir cita ahora. Podemos empezar por algo pequeño, por donde te resulte más fácil.'],
  [25, 'Tu historia', 'Miramos qué estaba pasando cuando empezaste a sentirte así y qué te ha ayudado hasta hoy.'],
  [40, 'Objetivos', 'Imaginamos juntas cómo se notaría en tu día a día que algo empieza a cambiar.'],
  [47, 'Cierre y próximos pasos', 'Recogemos lo hablado y decides con calma si quieres volver y qué te gustaría trabajar.'],
]
const approach = [
  ['I', 'Escuchar con tiempo', 'Podemos hablar de ansiedad, duelo, autoestima o de una relación que te preocupa. Tú decides por dónde empezamos.'],
  ['II', 'Entender lo que se repite', 'Observamos cómo se relacionan lo que piensas, lo que sientes y lo que haces cuando algo te cuesta.'],
  ['III', 'Probar algo distinto', 'Acordamos cambios pequeños que puedas llevar a tu vida. Revisamos qué te sirve y qué necesita otro ritmo.'],
]
const quotes = [
  ['Me ayudó poder decir en voz alta cosas a las que llevaba tiempo dándoles vueltas.', 'M. A., 34 años'],
  ['Ahora me doy cuenta antes de cuándo necesito parar y pedir ayuda.', 'L. R., 41 años'],
  ['Pude hablar de lo que me daba vergüenza sin sentir que tenía que justificarme.', 'C. S., 29 años'],
]
---
<section class="hero home-hero shell">
  <div class="hero-title">
    <p class="eyebrow">Psicología en Valencia y online</p>
    <h1><span>Un lugar para hablar.</span><em>Tiempo para entenderte.</em></h1>
  </div>
  <figure class="portrait">
    <Photo name="retrato" eager alt="Retrato de Inés Arranz" sizes="(max-width: 720px) 13rem, 40vw" />
    <figcaption class="eyebrow"><strong>Inés Arranz</strong><span>Psicóloga General Sanitaria · Col. CV-14872</span></figcaption>
  </figure>
  <div class="hero-actions">
    <div class="thoughts" data-cycle tabindex="0" aria-label="Ejemplos de reestructuración cognitiva">
      <p class="eyebrow">Una forma de mirar lo que piensas</p>
      <div class="stack">
        {thoughts.map(([thought, reframe], index) => <div class:list={['pair', { active: index === 0 }]} aria-hidden={index !== 0}><p><del>{thought}</del></p><p>{reframe}</p></div>)}
      </div>
    </div>
    <a class="text-link" href={url('ines-arranz/agenda/?modalidad=llamada')}>Pedir una primera cita</a>
    <p class="appointment-note">Primera llamada de 15 min, sin coste</p>
  </div>
</section>

<section class="session shell" data-session aria-labelledby="primera-sesion">
  <div class="session-sticky">
    <p class="eyebrow">Una sesión de 50 minutos</p>
    <h2 id="primera-sesion">La primera sesión,<br /><em>minuto a minuto</em></h2>
    <div class="ruler" aria-hidden="true">
      <div class="ruler-track">
        {Array.from({ length: 51 }, (_, index) => <i class:list={{ major: index % 5 === 0 }}></i>)}
      </div>
      <div class="needle-track"><i></i></div>
      <div class="ruler-labels">{[0, 10, 20, 30, 40, 50].map(minute => <span>{minute}′</span>)}</div>
    </div>
    <ol class="moments">
      {moments.map(([minute, title, body], index) => <li class:list={{ active: index === 0 }}><p class="eyebrow">{minute}′</p><h3>{title}</h3><p>{body}</p></li>)}
    </ol>
  </div>
</section>

<section class="shell section approach">
  <h2>Así trabajo</h2>
  <div class="columns">{approach.map(([numeral, title, body]) => <div><p class="eyebrow">{numeral}</p><h3>{title}</h3><p>{body}</p></div>)}</div>
  <blockquote class="pull">«Podemos ir despacio. Lo importante es que lo que hagamos aquí tenga sentido para ti.»</blockquote>
  <a class="text-link" href={url('ines-arranz/sobre-mi/')}>Sobre mí y mi forma de trabajar</a>
</section>
<Space />

<section class="shell section testimonials">
  <h2 class="eyebrow">Testimonios ficticios</h2>
  <div class="stack" data-cycle tabindex="0" aria-label="Testimonios">
    {quotes.map(([quote, name], index) => <figure class:list={{ active: index === 0 }} aria-hidden={index !== 0}><blockquote>«{quote}»</blockquote><figcaption class="eyebrow">{name}</figcaption></figure>)}
  </div>
</section>

<section class="shell section editorial">
  <h2>Tarifas</h2>
  <div>
    <table><thead><tr><th scope="col">Modalidad</th><th scope="col">Duración</th><th scope="col">Precio</th></tr></thead>
      <tbody><tr><th scope="row">Presencial u online</th><td>50 min</td><td>60 €</td></tr><tr><th scope="row">Primera llamada</th><td>15 min</td><td>Sin coste</td></tr></tbody>
    </table>
    <a class="text-link" href={url('ines-arranz/agenda/')}>Consultar la agenda</a>
  </div>
</section>

<section class="shell section">
  <header class="section-heading"><h2>Del cuaderno</h2><a class="text-link" href={url('ines-arranz/blog/')}>Ver todos los ensayos</a></header>
  {posts.map((post, index) => <PostCard {post} number={index + 1} />)}
</section>
