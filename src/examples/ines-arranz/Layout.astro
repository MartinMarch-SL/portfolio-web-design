---
import PortfolioIcons from '../../lib/PortfolioIcons.astro'
import { url } from '../../lib/url'
import '@fontsource-variable/fraunces/full.css'
import '@fontsource-variable/fraunces/full-italic.css'
import '@fontsource-variable/manrope'
import './styles/base.css'

const { title, description = 'Psicología en Ruzafa, Valencia, y online.' } = Astro.props
const links = [['', 'Inicio'], ['sobre-mi/', 'Sobre mí'], ['blog/', 'Blog'], ['agenda/', 'Agenda']]
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#F1ECE4" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="description" content={description} />
    <PortfolioIcons />
    <link rel="alternate" type="application/rss+xml" title="Inés Arranz · Blog" href={url('ines-arranz/rss.xml')} />
    <title>{title ? title + ' · Inés Arranz' : 'Inés Arranz · Psicología'}</title>
  </head>
  <body style={`--grain: url("${url('examples/ines-arranz/img/grain.png')}")`}>
    <a class="skip" href="#contenido">Saltar al contenido</a>
    <header class="mast shell">
      <a class="brand" href={url('ines-arranz/')}>Inés Arranz <span>Psicología</span></a>
      <nav aria-label="Principal">
        {links.map(([path, label]) => <a href={url('ines-arranz/' + path)} aria-current={Astro.url.pathname === url('ines-arranz/' + path) ? 'page' : undefined}>{label}</a>)}
      </nav>
    </header>
    <main id="contenido"><slot /></main>
    <footer class="dark">
      <div class="shell footer">
        <div><p class="eyebrow">Consulta de psicología</p><p class="footer-name">Inés Arranz</p><p>Ruzafa, Valencia · Online<br />Col. CV-14872</p></div>
        <div><p class="eyebrow">Contacto</p><a href="mailto:hola@ines-arranz.example">hola@ines-arranz.example</a><p>Si estás en crisis, llama al <a href="tel:024">024</a>.</p></div>
        <div><a href={url('ines-arranz/privacidad/')}>Privacidad</a><br /><a href={url('')}>Volver al catálogo</a></div>
      </div>
    </footer>
  </body>
</html>
<script>
  import './scripts/motion'
</script>
