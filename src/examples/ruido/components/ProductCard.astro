---
import { url } from '../../../lib/url'
import { responsiveImage } from '../../../lib/responsive-image'
import type { Product } from '../data/products'
import { euros } from '../lib/price'
import DistortImage from './DistortImage.astro'

interface Props {
  product: Product
  index?: number
  total?: number
  priority?: boolean
}
const { product, index, total, priority } = Astro.props
const sizes = index === undefined
  ? '(max-width: 768px) 46vw, 30vw'
  : '(max-width: 768px) 92vw, clamp(240px, 31vw, 512px)'
const soldOut = product.sizes.length > 0 && product.sizes.every(size => product.soldOut.includes(size))
---
<article class="product-card">
  <a href={url(`ruido/producto/${product.slug}/`)} data-cursor="VER">
    <div class="card-image" transition:name={`ruido-img-${product.slug}`}>
      <DistortImage src={product.images[0]} alt="" sizes={sizes} priority={priority} />
      {index === undefined && product.images[1] && <img class="alternate" data-distort-hover-source {...responsiveImage(product.images[1], sizes)} alt="" loading="lazy" decoding="async" />}
    </div>
    <div class:list={['details', { numbered: index !== undefined }]}>
      {index !== undefined && <span>{String(index).padStart(2, '0')}/{String(total).padStart(2, '0')}</span>}
      <h3>{product.name}</h3>
      <span>{euros.format(product.price)}</span>
    </div>
    {soldOut ? <s class="tag">Agotado</s> : product.isNew && index === undefined && <span class="tag">Nuevo</span>}
  </a>
</article>
<style>
  a { display: block; }
  .card-image { position: relative; }
  .card-image :global(canvas) { z-index: 1; }
  .alternate { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0; visibility: hidden; pointer-events: none; }
  @media (hover: hover) and (pointer: fine) {
    .card-image:hover .alternate { opacity: 1; visibility: visible; }
  }
  @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    .alternate { transition: opacity .4s var(--ease), visibility .4s; }
  }
  .details { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: .4rem; align-items: baseline; padding-top: .65rem; font: .6875rem/1.4 var(--mono); }
  .details.numbered { grid-template-columns: auto minmax(0, 1fr) auto; border-top: 1px solid var(--hairline); padding-block: .85rem; }
  .details h3 { font: 700 clamp(.86rem, 1.4vw, 1.4rem)/1.12 var(--display); letter-spacing: -.025em; margin: 0; overflow-wrap: anywhere; }
  .details span { white-space: nowrap; }
  .tag { display: inline-block; padding: .14rem .28rem; margin-top: .35rem; color: var(--asphalt); background: var(--signal); font: .625rem var(--mono); text-transform: uppercase; }
  s.tag { background: none; color: inherit; padding-inline: 0; }
</style>
