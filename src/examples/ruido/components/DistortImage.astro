---
import { url } from '../../../lib/url'

interface Props {
  src: string
  alt: string
  class?: string
}
const { src, alt, class: className } = Astro.props
---
<div class:list={['distort-image', className]} data-distort-image>
  <img src={url(src)} alt={alt} loading="lazy" decoding="async" />
</div>
<style>
  .distort-image { position: relative; overflow: hidden; aspect-ratio: 4 / 5; background: var(--concrete); }
  .distort-image img { width: 100%; height: 100%; object-fit: cover; }
  .distort-image :global(canvas) { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; }
  @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    .distort-image img { transition: transform .35s var(--ease); }
    .distort-image:not(:has(canvas)):hover img { transform: scale(1.025); }
  }
</style>
