---
import { url } from '../../../lib/url'
---
<header class="ruido-header">
  <a class="ruido-wordmark" href={url('ruido/')} aria-label="RUIDO, inicio">RUIDO</a>
  <nav aria-label="Principal">
    <a href={url('ruido/tienda/')}>Tienda</a>
    <a href={url('ruido/#lookbook')} data-cursor="VER">Lookbook</a>
  </nav>
  <button class="ruido-cart" type="button" id="ruido-cart-button" popovertarget="ruido-cart" data-magnetic>Carrito (<span data-cart-count>0</span>)</button>
  <div id="ruido-cart" class="ruido-cart-panel" popover>
    <p>El carrito está vacío.</p>
    <button type="button" popovertarget="ruido-cart" popovertargetaction="hide">Cerrar</button>
  </div>
</header>
