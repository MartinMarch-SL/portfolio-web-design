---
import { products } from '../data/products'

const categories = ['Todo', 'Sudaderas', 'Camisetas', 'Pantalones', 'Chaquetas', 'Accesorios']
const colors = [...new Set(products.flatMap(product => product.colors.map(color => color.name)))]
---
<div class="controls" aria-label="Filtros del catálogo">
  <div class="category" role="group" aria-label="Categoría">
    <span>Categoría:</span>
    {categories.map((label, index) => (
      <Fragment>{index > 0 && <span aria-hidden="true">/</span>}<button type="button" data-category-filter={index ? label.toLowerCase() : ''} aria-pressed={!index}>{label}</button></Fragment>
    ))}
  </div>
  <div class="options">
    <label>Talla
      <select data-size-filter>
        <option value="">Todas</option>
        {['XS', 'S', 'M', 'L', 'XL', 'XXL'].map(size => <option>{size}</option>)}
      </select>
    </label>
    <label>Color
      <select data-color-filter>
        <option value="">Todos</option>
        {colors.map(color => <option>{color}</option>)}
      </select>
    </label>
    <label>Orden
      <select data-sort>
        <option value="nuevo">Novedades</option>
        <option value="precio-asc">Precio ↑</option>
        <option value="precio-desc">Precio ↓</option>
      </select>
    </label>
    <div class="density" role="group" aria-label="Vista de la rejilla">
      <button type="button" data-density="wide" aria-pressed="true">Amplio</button>
      <span aria-hidden="true">/</span>
      <button type="button" data-density="dense" aria-pressed="false">Denso</button>
    </div>
  </div>
</div>
<style>
  .controls { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; column-gap: 1rem; padding: .8rem 0; border-block: 1px solid var(--hairline); font: .69rem/1.5 var(--mono); text-transform: uppercase; }
  .category, .options, .density { display: flex; align-items: center; flex-wrap: wrap; gap: .15rem .6rem; }
  button, select { font: inherit; text-transform: inherit; color: inherit; background: none; border: 0; padding: .33rem 0; }
  select { cursor: pointer; }
  button[aria-pressed="true"] { text-decoration: underline; text-decoration-color: var(--signal); text-decoration-thickness: 2px; text-underline-offset: .35em; }
</style>
