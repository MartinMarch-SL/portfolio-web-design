---
import { products } from '../data/products'
import { url } from '../../../lib/url'
import ProductCard from './ProductCard.astro'

const drop = products.filter(product => product.drop === '04')
---
<section data-section="drop" id="tienda" class="drop" aria-labelledby="rail-title">
  <div class="stage" data-rail-stage>
    <div class="heading">
      <div class="section-line"><p>Serie 04 / 2026</p><a href={url('ruido/tienda/')}>Ver catálogo <span aria-hidden="true">↗</span></a></div>
      <h2 id="rail-title">La tirada.</h2>
    </div>
    <div class="window" data-rail-window>
      <ul data-rail-track>
        {drop.map(product => <li><ProductCard product={product} index={products.indexOf(product) + 1} total={products.length} /></li>)}
      </ul>
    </div>
    <div class="progress" aria-hidden="true"><span></span></div>
  </div>
</section>
<style>
  .drop { background: var(--chalk); color: var(--asphalt); --hairline: #0e0e0e40; }
  .stage { padding: clamp(1.3rem, 3vh, 3rem) var(--gutter) 1.5rem; }
  h2 { margin: .2em 0; font: 880 clamp(3.6rem, 10vw, 9rem)/.83 var(--display); font-variation-settings: 'wdth' 72; letter-spacing: -.045em; }
  ul { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr)); gap: 1.25rem; padding: 0; margin: 0; list-style: none; }
  li { min-width: 0; }
  .progress { display: none; }
  @media (min-width: 769px) and (prefers-reduced-motion: no-preference) {
    .drop[data-rail-active] { height: calc(var(--stage-height) + var(--travel)); }
    [data-rail-active] .stage { position: sticky; top: 0; }
    [data-rail-active] .window { overflow: clip; margin-inline: calc(-1 * var(--gutter)); }
    [data-rail-active] ul { display: flex; width: max-content; padding-inline: var(--gutter); transform: translateX(var(--offset, 0px)); }
    [data-rail-active] li { flex: 0 0 clamp(15rem, 31vw, 32rem); }
    [data-rail-active] li :global(.distort-image) { width: 100%; height: clamp(8rem, min(56svh, calc(100svh - 18rem)), 38rem); }
    [data-rail-active] .progress { display: block; height: 1px; margin-top: .6rem; background: var(--hairline); }
    .progress span { display: block; width: 100%; height: 100%; background: var(--asphalt); transform: scaleX(var(--progress, 0)); transform-origin: left; }
    [data-rail-active] li:nth-child(even) { transform: translateY(calc(12px * (1 - var(--progress, 0)))); }
  }
  @media (max-width: 768px) { ul { grid-template-columns: minmax(0, 1fr); } }
</style>
