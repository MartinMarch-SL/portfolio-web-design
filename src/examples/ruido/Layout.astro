---
import PortfolioIcons from '../../lib/PortfolioIcons.astro'
import { ClientRouter } from 'astro:transitions'
import '@fontsource-variable/archivo/wdth.css'
import '@fontsource/jetbrains-mono/400.css'
import './styles/tokens.css'
import './styles/base.css'
import Header from './components/Header.astro'
import Footer from './components/Footer.astro'
import CartDrawer from './components/CartDrawer.astro'
import { url } from '../../lib/url'

const { title = 'RUIDO · Fet a Barcelona' } = Astro.props
---
<!doctype html>
<html lang="es" class="ruido">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <PortfolioIcons />
    <title>{title}</title>
    <ClientRouter />
  </head>
  <body style={`--grain-image: url("${url('examples/ruido/img/grain.png')}")`}>
    <Header />
    <slot />
    <Footer />
    <CartDrawer />
  </body>
</html>
<script>
  import './scripts/smooth-scroll'
  import './scripts/cursor'
  import './scripts/magnetic'
  import './scripts/wordmark'
  import './scripts/distort'
  import './scripts/cart-ui'
</script>
