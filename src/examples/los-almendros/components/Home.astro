---
import Layout from '../Layout.astro'
import NewsList from './NewsList.astro'
import PitchLines from './PitchLines.astro'
import Kits from './Kits.astro'
import { categories, fixtures } from '../data/season'
import { route, image, photo } from '../lib/paths'
const match = fixtures[0]
const ticker = [...fixtures.filter(item => item.result).reverse(), match]
---
<Layout>
  <section class="hero">
    <div class="stadium-lights" data-stage aria-hidden="true"><i></i><i></i><i></i><i></i></div>
    <div class="stadium" data-stage aria-hidden="true"><div class="stadium-pitch turf" data-stadium-pitch><PitchLines draw /></div></div>
    <div class="wrap hero-inner">
      <div class="hero-copy">
        <p class="eyebrow"><span class="mark"></span> CLUB DE FÚTBOL BASE / DESDE 1972</p>
        <h1>El fútbol<br />del barrio.</h1>
        <p>Desde chupetines hasta juvenil. En el Municipal de Los Almendros aprendemos a jugar y a cuidar del equipo.</p>
        <a class="button primary" href={route('inscripcion/')}>Preinscripción 2026/27</a>
      </div>
    </div>
    <figure class="ball-stage" data-ball aria-hidden="true">
        <img src={image('balon.svg')} width="370" height="370" alt="" />
        <canvas hidden aria-hidden="true"></canvas>
    </figure>
  </section>
  <div class="ticker">
    <a class="ticker-label" href={route('competicion/')}>Marcador</a>
    <div class="ticker-window" data-section="ticker">
      <div class="ticker-track">
        {[false, true].map(copy => <ul aria-hidden={copy ? 'true' : undefined}>
          {ticker.map(item => <li><span>{item.result ? item.team : 'Próximo · ' + item.team}</span> {item.home} <strong>{item.result || 'vs.'}</strong> {item.away}{!item.result && <span> · {item.date}</span>}</li>)}
        </ul>)}
      </div>
    </div>
    <button type="button" class="ticker-toggle" hidden>Pausar</button>
  </div>
  <section class="match-band night">
    <div class="wrap match" data-reveal>
      <div class="match-round"><span>Jornada</span><strong class="dorsal">09</strong></div>
      <div class="match-act">
        <p class="eyebrow">PRÓXIMO PARTIDO · {match.team}</p>
        <h2>{match.home} <span>vs.</span> {match.away}</h2>
        <p>{match.date} · {match.venue}</p>
      </div>
      <a class="text-link" href={route('competicion/')}>Calendario y resultados</a>
    </div>
  </section>
  <div class="turf signup-surface"><section class="wrap section split signup" data-reveal>
    <div><p class="eyebrow">TEMPORADA 2026/27</p><h2>Tu sitio en el campo</h2><p>Consulta la categoría por año de nacimiento y empieza la preinscripción.</p></div>
    <form class="quick" action={route('inscripcion/')} data-quick>
      <label for="quick-year">Año de nacimiento</label>
      <select name="anio" id="quick-year" required>
        <option value="">Selecciona un año</option>
        {Array.from({ length: 15 }, (_, index) => 2022 - index).map(year => <option>{year}</option>)}
      </select>
      <div class="quick-act" aria-live="polite">
        <output for="quick-year"></output>
        <p data-quick-details>Elige el año para consultar el horario y la cuota.</p>
      </div>
      <button class="button primary">Empezar preinscripción</button>
    </form>
  </section></div>
  <section class="wrap section split editorial" data-reveal>
    <div><p class="eyebrow">NUESTRA ESCUELA</p><h2>Aprender jugando</h2><img class="photo section-photo" {...photo('entrenamiento')} alt="Un jugador regatea entre conos" loading="lazy" /></div>
    <div><p>Entrenamos en grupos pequeños y trabajamos con balón desde el primer día. Repartimos los minutos, rotamos posiciones y damos espacio para que cada jugador tome sus propias decisiones.</p><p>El respeto al rival, al árbitro y a la persona que comparte vestuario se entrena cada semana.</p><a class="text-link" href={route('equipos/')}>Conoce a los equipos</a></div>
  </section>
  <div class="programme"><section class="wrap section" data-reveal>
    <div class="section-heading"><div><p class="eyebrow">DESDE LA BANDA</p><h2>Últimas noticias</h2></div><a class="text-link" href={route('noticias/')}>Todas las noticias</a></div>
    <NewsList limit={3} carousel />
  </section></div>
  <Kits />
  <section class="stats-band turf"><div class="wrap stats" data-reveal>
    <div><strong data-count>1972</strong><span>Año de fundación</span></div><div><strong data-count>18</strong><span>Equipos</span></div><div><strong data-count>300</strong><span>Fichas del club</span></div><div><strong data-count>25</strong><span>Entrenadores</span></div>
  </div></section>
  <section class="wrap section" data-reveal>
    <div class="section-heading"><h2>Categorías</h2><a class="text-link" href={route('equipos/')}>Todos los equipos</a></div>
    <div class="dorsal-rail">{categories.map(category => <a href={route('equipos/#' + category.first)}><strong>{String(category.first).slice(2)}–{String(category.last).slice(2)}</strong><span>{category.name}</span></a>)}</div>
  </section>
  <section class="wrap section" data-reveal><p class="eyebrow">MUNICIPAL LOS ALMENDROS</p><h2>El campo, de cerca</h2>
    <div class="split section-photo ground-photos">
      <img class="photo" src={image('circulo.webp')} srcset={`${image('circulo-640w.webp')} 640w, ${image('circulo.webp')} 800w`} sizes="(max-width: 630px) 100vw, 50vw" width="800" height="800" alt="Líneas de cal del círculo central" loading="lazy" />
      <img class="photo" {...photo('atardecer')} alt="Dos jugadores en el campo al atardecer" loading="lazy" />
    </div>
    <div class="gallery ground-gallery">{[['grada', 'La grada'], ['entrenamiento', 'Una tarde de entreno'], ['hero', 'El círculo central'], ['portero', 'Bajo los palos']].map(([file, label]) => <figure><img class="photo" {...photo(file, '(max-width: 630px) 50vw, 25vw')} alt={file === 'hero' ? 'Jugadores reunidos en el círculo central, vistos desde arriba' : ''} loading="lazy" /><figcaption>{label}</figcaption></figure>)}</div>
  </section>
  <section class="wrap section sponsors"><h2>Comercio del barrio</h2><ul><li>Horno La Espiga Alta</li><li>Ferretería El Seto</li><li>Frutería La Almendra</li></ul></section>
</Layout>
