---
import Photo from './Photo.astro'
import { address, phone, telephone, timeline } from '../data/bar'
import '../styles/casa.css'
---
<header class="wrap page-title">
  <p class="kicker">Bar Caribe · Desde 1974</p>
  <h1>La casa</h1>
</header>
<div class="wrap casa">
  <section class="history" data-reveal>
    <Photo name="sala" alt="La sala del Bar Caribe" width={1600} height={1067} eager />
    <div>
      <h2>La persiana</h2>
      <ol class="timeline">
        {timeline.map(([year, event]) => <li><strong>{year}</strong><p>{event}</p></li>)}
      </ol>
    </div>
  </section>
  <section class="regulars block" data-reveal>
    <h2>Los de siempre</h2>
    <div>
      <figure>
        <Photo name="gente-01" alt="Lola detrás de la barra" />
        <figcaption><strong>Lola y Paco</strong><p>Ella lleva la barra. Él se ocupa de que salga caliente.</p></figcaption>
      </figure>
      <figure>
        <Photo name="gente-02" alt="Parroquianos del Caribe" />
        <figcaption><strong>Los parroquianos</strong><p>Entran, se sientan y Lola ya sabe qué ponerles.</p></figcaption>
      </figure>
    </div>
  </section>
  <section class="visit" data-reveal>
    <div>
      <h2>Cómo llegar</h2>
      <p>{address}</p>
      <p><a href={telephone}>{phone}</a></p>
      <p>De martes a domingo. Lunes cerrado.<br />Cocina de 13:00 a 16:00 y de 20:00 a 23:30.</p>
      <a class="action" href="https://www.openstreetmap.org/search?query=Calle%20de%20la%20Esperanza%2012%2C%20Madrid">Ver en el mapa</a>
    </div>
    <Photo name="calle" alt="La calle de la Esperanza, en Lavapiés" width={1600} height={1067} />
  </section>
</div>
